# Copy to .env and fill in. .env is gitignored.

# Anthropic API key used for categorizing new merchants with Claude Haiku 5.5.
# Optional if you've run `ant auth login` (the SDK picks up that profile).
ANTHROPIC_API_KEY=

# Optional overrides
# EXPENSE_TRACKER_DB=data/expenses.db
# EXPENSE_TRACKER_MODEL=claude-haiku-5-5
# EXPENSE_TRACKER_PORT=8765
